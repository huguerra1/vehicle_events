  "item": [
    {
      "name": "Autenticação",
      "description": "Rotas públicas de registro e login com emissão de token Bearer (Laravel Passport) e consulta do usuário autenticado.",
      "item": [
        {
          "name": "Registrar usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json && json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}",
                  "if (pm.response.json().user) { pm.collectionVariables.set('userId', pm.response.json().user.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"senha1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Registra um novo usuário com nome, e-mail único e senha (mínimo de 8 caracteres) e salva automaticamente o token Bearer na variável `token`."
          },
          "response": []
        },
